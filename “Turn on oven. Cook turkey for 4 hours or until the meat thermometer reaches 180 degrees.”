print("Start")

print("Turn on oven")

while True:
    print("Cook turkey")

    hours = input("Has it cooked for 4 hours? (Yes/No): ").strip().lower()
    
    if hours == "yes":
        print("Stop cooking")
        break
    elif hours == "no":
        temp = input("Has the turkey reached 180 degrees? (Yes/No): ").strip().lower()
        
        if temp == "yes":
            print("Stop cooking")
            break
        elif temp == "no":
            continue
        else:
            print("Please type Yes or No")
    else:
        print("Please type Yes or No")

print("End")